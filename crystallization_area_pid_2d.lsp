  ;; Colors chosen for black AutoCAD background: white/cyan/green/magenta/red/orange.
  (pid:make-layer "PID_EQUIPMENT" 7 "CONTINUOUS" "0.30")
  (pid:make-layer "PID_PROCESS_LINE" 4 "CONTINUOUS" "0.35")
  (pid:make-layer "PID_UTILITY_LINE" 3 "DASHED" "0.25")
  (pid:make-layer "PID_INSTRUMENT" 6 "CONTINUOUS" "0.18")
  (pid:make-layer "PID_SIGNAL" 6 "DASHED" "0.18")
  (pid:make-layer "PID_VALVE" 1 "CONTINUOUS" "0.25")
  (pid:make-layer "PID_TEXT" 7 "CONTINUOUS" "0.18")
  (pid:make-layer "PID_TITLE_BLOCK" 8 "CONTINUOUS" "0.25")
  (pid:make-layer "PID_BOUNDARY" 8 "CONTINUOUS" "0.25")
  (pid:make-layer "PID_TABLE" 7 "CONTINUOUS" "0.18")
  (pid:make-layer "PID_SAFETY" 30 "CONTINUOUS" "0.25")
)

(defun pid:line (p1 p2 lay /)
  (pid:set-layer lay)
  (entmakex (list '(0 . "LINE") (cons 8 lay) (cons 10 p1) (cons 11 p2)))
)
(defun pid:circle (cen rad lay /)
  (pid:set-layer lay)
  (entmakex (list '(0 . "CIRCLE") (cons 8 lay) (cons 10 cen) (cons 40 rad)))
)
(defun pid:arc (cen rad a1 a2 lay /)
  (pid:set-layer lay)
  (entmakex (list '(0 . "ARC") (cons 8 lay) (cons 10 cen) (cons 40 rad) (cons 50 a1) (cons 51 a2)))
)
(defun pid:pline (pts lay closed / data)
  (pid:set-layer lay)
  (setq data (list '(0 . "LWPOLYLINE") '(100 . "AcDbEntity") (cons 8 lay)
                   '(100 . "AcDbPolyline") (cons 90 (length pts)) (cons 70 (if closed 1 0))))
  (foreach p pts (setq data (append data (list (cons 10 (list (car p) (cadr p)))))))
  (entmakex data)
)
(defun pid:rect (x1 y1 x2 y2 lay /)
  (pid:pline (list (pid:pt x1 y1) (pid:pt x2 y1) (pid:pt x2 y2) (pid:pt x1 y2)) lay T)
)
(defun pid:text (pt h str lay /)
  (pid:set-layer lay)
  (entmakex (list '(0 . "TEXT") (cons 8 lay) (cons 10 pt) (cons 40 h) (cons 1 str)
                  '(50 . 0.0) '(7 . "Standard") '(72 . 0) '(73 . 0)))
)
(defun pid:mtext (pt w h str lay /)
  (pid:set-layer lay)
  (entmakex (list '(0 . "MTEXT") (cons 8 lay) (cons 10 pt) (cons 40 h) (cons 41 w)
                  (cons 1 str) '(7 . "Standard") '(71 . 1))))

(defun pid:block-start (name / obj made)
  ;; Rebuild blocks on every run so older oversized block definitions are not reused.
  ;; If AutoCAD refuses to delete an old referenced block, skip redefining that block
  ;; rather than leaking symbol geometry into model space.
  (if (setq obj (tblobjname "BLOCK" name))
    (vl-catch-all-apply 'entdel (list obj))
  )
  (if (not (tblsearch "BLOCK" name))
    (setq made (entmakex (list '(0 . "BLOCK") (cons 2 name) '(70 . 0) (cons 10 (pid:pt 0 0)))))
  )
  (if made T nil)
)
(defun pid:block-end () (entmakex '((0 . "ENDBLK"))))

(defun pid:define-blocks (/)
  (if (pid:block-start "BLK_PID_VERTICAL_TANK")
    (progn (pid:rect -7 -11 7 11 "PID_EQUIPMENT") (pid:arc (pid:pt 0 11) 7 0 pi "PID_EQUIPMENT") (pid:arc (pid:pt 0 -11) 7 pi (* 2 pi) "PID_EQUIPMENT") (pid:line (pid:pt -5 -11) (pid:pt -8 -15) "PID_EQUIPMENT") (pid:line (pid:pt 5 -11) (pid:pt 8 -15) "PID_EQUIPMENT") (pid:block-end)))
  (if (pid:block-start "BLK_PID_VACUUM_CRYSTALLIZER")
    (progn (pid:rect -9 -12 9 12 "PID_EQUIPMENT") (pid:arc (pid:pt 0 12) 9 0 pi "PID_EQUIPMENT") (pid:arc (pid:pt 0 -12) 9 pi (* 2 pi) "PID_EQUIPMENT") (pid:line (pid:pt -9 3) (pid:pt 9 3) "PID_EQUIPMENT") (pid:line (pid:pt -9 -4) (pid:pt 9 -4) "PID_EQUIPMENT") (pid:line (pid:pt 0 20) (pid:pt 0 12) "PID_EQUIPMENT") (pid:block-end)))
  (if (pid:block-start "BLK_PID_CENTRIFUGE")
    (progn (pid:circle (pid:pt 0 0) 10 "PID_EQUIPMENT") (pid:circle (pid:pt 0 0) 5 "PID_EQUIPMENT") (pid:line (pid:pt -8 -6) (pid:pt 8 6) "PID_EQUIPMENT") (pid:line (pid:pt -8 6) (pid:pt 8 -6) "PID_EQUIPMENT") (pid:block-end)))
  (if (pid:block-start "BLK_PID_DRYER")
    (progn (pid:rect -13 -6 13 6 "PID_EQUIPMENT") (pid:line (pid:pt -10 -6) (pid:pt -5 6) "PID_EQUIPMENT") (pid:line (pid:pt 0 -6) (pid:pt 5 6) "PID_EQUIPMENT") (pid:line (pid:pt 8 -6) (pid:pt 13 6) "PID_EQUIPMENT") (pid:block-end)))
  (if (pid:block-start "BLK_PID_COOLER")
    (progn (pid:rect -11 -6 11 6 "PID_EQUIPMENT") (pid:line (pid:pt -11 0) (pid:pt 11 0) "PID_EQUIPMENT") (pid:line (pid:pt -5 -6) (pid:pt -5 6) "PID_EQUIPMENT") (pid:line (pid:pt 5 -6) (pid:pt 5 6) "PID_EQUIPMENT") (pid:block-end)))
  (if (pid:block-start "BLK_PID_MANUAL_VALVE")
    (progn (pid:pline (list (pid:pt -4 -3) (pid:pt 0 0) (pid:pt -4 3)) "PID_VALVE" T) (pid:pline (list (pid:pt 4 -3) (pid:pt 0 0) (pid:pt 4 3)) "PID_VALVE" T) (pid:block-end)))
  (if (pid:block-start "BLK_PID_CONTROL_VALVE")
    (progn (pid:pline (list (pid:pt -5 -3) (pid:pt 0 0) (pid:pt -5 3)) "PID_VALVE" T) (pid:pline (list (pid:pt 5 -3) (pid:pt 0 0) (pid:pt 5 3)) "PID_VALVE" T) (pid:line (pid:pt 0 0) (pid:pt 0 8) "PID_VALVE") (pid:circle (pid:pt 0 10) 2.5 "PID_VALVE") (pid:block-end)))
  (if (pid:block-start "BLK_PID_CHECK_VALVE")
    (progn (pid:pline (list (pid:pt -5 -4) (pid:pt 5 0) (pid:pt -5 4)) "PID_VALVE" T) (pid:line (pid:pt 6 -4) (pid:pt 6 4) "PID_VALVE") (pid:block-end)))
  (if (pid:block-start "BLK_PID_INSTRUMENT_BUBBLE") (progn (pid:circle (pid:pt 0 0) 5 "PID_INSTRUMENT") (pid:block-end)))
  (if (pid:block-start "BLK_PID_OFFPAGE_CONNECTOR")
    (progn (pid:pline (list (pid:pt -12 -5) (pid:pt 7 -5) (pid:pt 13 0) (pid:pt 7 5) (pid:pt -12 5)) "PID_BOUNDARY" T) (pid:block-end)))
  (if (pid:block-start "BLK_PID_FLOW_ARROW") (progn (pid:pline (list (pid:pt -3 -2) (pid:pt 4 0) (pid:pt -3 2)) "PID_PROCESS_LINE" T) (pid:block-end)))
  (if (pid:block-start "BLK_PID_SAMPLE_POINT") (progn (pid:circle (pid:pt 0 0) 2 "PID_SAFETY") (pid:line (pid:pt 0 0) (pid:pt 0 -6) "PID_SAFETY") (pid:block-end)))
  (if (pid:block-start "BLK_PID_DRAIN") (progn (pid:line (pid:pt 0 0) (pid:pt 0 -7) "PID_SAFETY") (pid:pline (list (pid:pt -4 -7) (pid:pt 4 -7) (pid:pt 0 -11)) "PID_SAFETY" T) (pid:block-end)))
  (if (pid:block-start "BLK_PID_VENT") (progn (pid:line (pid:pt 0 0) (pid:pt 0 7) "PID_SAFETY") (pid:arc (pid:pt 0 9) 2 0 pi "PID_SAFETY") (pid:block-end)))
  (if (pid:block-start "BLK_PID_PSV") (progn (pid:circle (pid:pt 0 0) 4 "PID_SAFETY") (pid:pline (list (pid:pt -3 -1) (pid:pt 0 3) (pid:pt 3 -1)) "PID_SAFETY" T) (pid:block-end)))
  (if (pid:block-start "BLK_PID_VACUUM_BREAKER") (progn (pid:circle (pid:pt 0 0) 4 "PID_SAFETY") (pid:text (pid:pt -2 -1.2) 2 "VB" "PID_SAFETY") (pid:block-end)))
)

(defun pid:insert (name pt sx sy rot lay /)
  (pid:set-layer lay)
  (entmakex (list '(0 . "INSERT") (cons 8 lay) (cons 2 name) (cons 10 pt) (cons 41 sx) (cons 42 sy) (cons 43 1.0) (cons 50 rot)))
)
(defun pid:tag (x y tag name /)
  (pid:text (pid:pt (- x 10) (- y 18)) 3.0 tag "PID_TEXT")
  (pid:text (pid:pt (- x 17) (- y 23)) 2.5 name "PID_TEXT")
)
(defun pid:inst (x y tag /)
  (pid:insert "BLK_PID_INSTRUMENT_BUBBLE" (pid:pt x y) 1 1 0 "PID_INSTRUMENT")
  (pid:text (pid:pt (- x 4.5) (- y 1.3)) 2.2 tag "PID_INSTRUMENT")
)
(defun pid:valve (x y tag rot ctrl /)
  (pid:insert (if ctrl "BLK_PID_CONTROL_VALVE" "BLK_PID_MANUAL_VALVE") (pid:pt x y) 1 1 rot "PID_VALVE")
  (pid:text (pid:pt (- x 6) (+ y 5)) 2.3 tag "PID_VALVE")
)
(defun pid:opcon (x y txt /)
  (pid:insert "BLK_PID_OFFPAGE_CONNECTOR" (pid:pt x y) 1 1 0 "PID_BOUNDARY")
  (pid:mtext (pid:pt (- x 11) (+ y 3)) 45 2.5 txt "PID_TEXT")
)
(defun pid:arrow-at (p1 p2 / x1 y1 x2 y2 ang)
  (setq x1 (car p1) y1 (cadr p1) x2 (car p2) y2 (cadr p2))
  (setq ang (atan (- y2 y1) (- x2 x1)))
  (pid:insert "BLK_PID_FLOW_ARROW" (pid:pt (/ (+ x1 x2) 2.0) (/ (+ y1 y2) 2.0)) 1 1 ang "PID_PROCESS_LINE")
)
(defun pid:path-line (pts lay / p1 p2)
  (setq p1 nil)
  (foreach p2 pts (if p1 (pid:line p1 p2 lay)) (setq p1 p2))
)
(defun pid:process-line (pts lineNo service labelx labely / segp1 segp2)
  (pid:path-line pts "PID_PROCESS_LINE")
  (setq segp1 (car pts) segp2 (cadr pts))
  (if (and (= (car segp1) (car segp2)) (> (length pts) 2)) (setq segp1 (cadr pts) segp2 (caddr pts)))
  (pid:arrow-at segp1 segp2)
  (pid:text (pid:pt labelx labely) 3.0 (strcat lineNo "  " service) "PID_TEXT")
)
(defun pid:utility-line (pts label x y /)
  (pid:path-line pts "PID_UTILITY_LINE")
  (if (> (length pts) 1) (pid:arrow-at (car pts) (cadr pts)))
  (pid:text (pid:pt x y) 2.5 label "PID_TEXT")
)
(defun pid:signal (pts /) (pid:path-line pts "PID_SIGNAL"))
(defun pid:control-station (x y tag /)
  (pid:valve (- x 7) y "HV" 0 nil)
  (pid:valve x y tag 0 T)
  (pid:valve (+ x 7) y "HV" 0 nil)
  (pid:line (pid:pt (- x 11) (+ y 8)) (pid:pt (+ x 11) (+ y 8)) "PID_PROCESS_LINE")
  (pid:line (pid:pt (- x 11) y) (pid:pt (- x 11) (+ y 8)) "PID_PROCESS_LINE")
  (pid:line (pid:pt (+ x 11) y) (pid:pt (+ x 11) (+ y 8)) "PID_PROCESS_LINE")
  (pid:valve x (+ y 8) "BYP" 0 nil)
)

