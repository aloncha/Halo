(defun pid:draw-table (x y title headers rows colw rowh / xx yy i j row)
  (pid:text (pid:pt x (+ y 5)) 3.0 title "PID_TABLE")
  (setq yy y)
  (pid:rect x (- yy rowh) (+ x (apply '+ colw)) yy "PID_TABLE")
  (setq xx x i 0)
  (foreach h headers
    (pid:text (pid:pt (+ xx 1) (- yy 4)) 1.8 h "PID_TABLE")
    (setq xx (+ xx (nth i colw)) i (1+ i))
    (pid:line (pid:pt xx yy) (pid:pt xx (- yy rowh)) "PID_TABLE"))
  (setq yy (- yy rowh))
  (foreach row rows
    (pid:rect x (- yy rowh) (+ x (apply '+ colw)) yy "PID_TABLE")
    (setq xx x j 0)
    (foreach cell row
      (pid:mtext (pid:pt (+ xx 1) (- yy 1)) (- (nth j colw) 2) 1.45 cell "PID_TABLE")
      (setq xx (+ xx (nth j colw)) j (1+ j))
      (pid:line (pid:pt xx yy) (pid:pt xx (- yy rowh)) "PID_TABLE"))
    (setq yy (- yy rowh)))
  yy
)

