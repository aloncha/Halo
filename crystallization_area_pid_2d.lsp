(defun pid:clear-modelspace (/ ss idx ent)
  ;; Delete visible drawing entities without calling ERASE through the command stack.
  (setq ss (ssget "_X" (list (cons 410 "Model"))))
  (if ss
    (progn
      (setq idx 0)
      (repeat (sslength ss)
        (setq ent (ssname ss idx))
        (if ent (entdel ent))
        (setq idx (1+ idx))
      )
    )
  )
)

(defun pid:run (/ *error* oldcmdecho oldosmode)
  (setq oldcmdecho (getvar "CMDECHO"))
  (setq oldosmode (getvar "OSMODE"))
  (defun *error* (msg)
    (if oldosmode (setvar "OSMODE" oldosmode))
    (if oldcmdecho (setvar "CMDECHO" oldcmdecho))
    (vl-catch-all-apply 'vl-cmdf (list "_.UNDO" "_E"))
    (princ (strcat "\nPIDCRYSTAL2D error: " msg))
    (princ)
  )
  (setvar "CMDECHO" 0)
  (setvar "OSMODE" 0)
  (vl-cmdf "_.UNDO" "_BE")
  (pid:setup-layers)
  (pid:define-blocks)
  (pid:clear-modelspace)
  (pid:draw-legend-notes-title)
  (pid:draw-equipment)
  (pid:draw-process)
  (pid:draw-utilities)
  (pid:draw-instruments)
  (pid:draw-safety)
  (pid:draw-tables)
  (vl-cmdf "_.ZOOM" "_E")
  (vl-cmdf "_.UNDO" "_E")
  (setvar "OSMODE" oldosmode)
  (setvar "CMDECHO" oldcmdecho)
  (princ "\nPIDCRYSTAL2D complete: 2D conceptual P&ID drawn in model space. ")
  (princ)
)

(defun c:PIDCRYSTAL2D () (pid:run))

(princ "\nLoaded crystallization_area_pid_2d.lsp. Run command PIDCRYSTAL2D to draw the 2D P&ID. ")
(princ)
