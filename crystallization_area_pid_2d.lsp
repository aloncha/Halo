;;; crystallization_area_pid_2d.lsp
;;; Conceptual 2D P&ID generator for AutoCAD / AutoCAD Plant 3D 2025.
;;; Command: PIDCRYSTAL2D
;;; Scope: Crystallization B/C and Final Molasses Area 302-319.
;;; IMPORTANT: This script creates 2D manual P&ID symbols only. It does not
;;; create native Plant 3D intelligent database objects and it does not use 3D
;;; commands/solids such as CYLINDER, BOX, CONE, SPHERE, or 3D solid entities.

(vl-load-com)

(setq *pid-note* "Literature-based assumed value; verify with actual plant/process data.")

(defun pid:pt (x y) (list x y 0.0))

(defun pid:ensure-linetype (lt /)
  (if (and lt (/= (strcase lt) "CONTINUOUS") (not (tblsearch "LTYPE" lt)))
    (vl-catch-all-apply 'vl-cmdf (list "_.-LINETYPE" "_Load" lt "acad.lin" ""))
  )
)

(defun pid:lineweight-code (lw / val)
  ;; AutoCAD stores lineweight as hundredths of a millimeter; e.g. 0.30 mm -> 30.
  (setq val (fix (+ 0.5 (* 100.0 (atof lw)))))
  (if (> val 0) val -3)
)

(defun pid:replace-dxf (code value data / found result pair)
  (setq found nil result nil)
  (foreach pair data
    (if (= (car pair) code)
      (progn (setq result (cons (cons code value) result)) (setq found T))
      (setq result (cons pair result))
    )
  )
  (if found (reverse result) (reverse (cons (cons code value) result)))
)

(defun pid:make-layer (name color ltype lw / obj data lwcode)
  ;; Use table edits instead of the COMMAND function to avoid command-order errors.
  (pid:ensure-linetype ltype)
  (setq lwcode (pid:lineweight-code lw))
  (if (setq obj (tblobjname "LAYER" name))
    (progn
      (setq data (entget obj))
      (setq data (pid:replace-dxf 62 color data))
      (setq data (pid:replace-dxf 6 ltype data))
      (setq data (pid:replace-dxf 370 lwcode data))
      (entmod data)
      (entupd obj)
    )
    (entmakex
      (list
        '(0 . "LAYER")
        '(100 . "AcDbSymbolTableRecord")
        '(100 . "AcDbLayerTableRecord")
        (cons 2 name)
        '(70 . 0)
        (cons 62 color)
        (cons 6 ltype)
        (cons 370 lwcode)
      )
    )
  )
)

(defun pid:setup-layers (/)
  (pid:make-layer "PID_EQUIPMENT" 7 "CONTINUOUS" "0.30")
  (pid:make-layer "PID_PROCESS_LINE" 5 "CONTINUOUS" "0.35")
  (pid:make-layer "PID_UTILITY_LINE" 4 "DASHED" "0.25")
  (pid:make-layer "PID_INSTRUMENT" 6 "CONTINUOUS" "0.18")
  (pid:make-layer "PID_SIGNAL" 6 "DASHED" "0.18")
  (pid:make-layer "PID_VALVE" 1 "CONTINUOUS" "0.25")
  (pid:make-layer "PID_TEXT" 7 "CONTINUOUS" "0.18")
  (pid:make-layer "PID_TITLE_BLOCK" 8 "CONTINUOUS" "0.25")
  (pid:make-layer "PID_BOUNDARY" 8 "CONTINUOUS" "0.25")
  (pid:make-layer "PID_TABLE" 7 "CONTINUOUS" "0.18")
  (pid:make-layer "PID_SAFETY" 30 "CONTINUOUS" "0.25")
)

(defun pid:set-layer (lay) (setvar "CLAYER" lay))

(defun pid:line (p1 p2 lay /)
  (pid:set-layer lay)
  (entmakex (list '(0 . "LINE") (cons 8 lay) (cons 10 p1) (cons 11 p2)))
)

(defun pid:circle (cen rad lay /)
  (pid:set-layer lay)
  (entmakex (list '(0 . "CIRCLE") (cons 8 lay) (cons 10 cen) (cons 40 rad)))
)

(defun pid:arc (cen rad a1 a2 lay /)
  (pid:set-layer lay)
  (entmakex (list '(0 . "ARC") (cons 8 lay) (cons 10 cen) (cons 40 rad) (cons 50 a1) (cons 51 a2)))
)

(defun pid:pline (pts lay closed / data)
  (pid:set-layer lay)
  (setq data (list '(0 . "LWPOLYLINE") '(100 . "AcDbEntity") (cons 8 lay) '(100 . "AcDbPolyline") (cons 90 (length pts)) (cons 70 (if closed 1 0))))
  (foreach p pts (setq data (append data (list (cons 10 (list (car p) (cadr p)))))))
  (entmakex data)
)

(defun pid:rect (x1 y1 x2 y2 lay /)
  (pid:pline (list (pid:pt x1 y1) (pid:pt x2 y1) (pid:pt x2 y2) (pid:pt x1 y2)) lay T)
)

(defun pid:text (pt h str lay /)
  (pid:set-layer lay)
  (entmakex (list '(0 . "TEXT") (cons 8 lay) (cons 10 pt) (cons 40 h) (cons 1 str) '(50 . 0.0) '(7 . "Standard") '(72 . 0) '(73 . 0)))
)

(defun pid:mtext (pt w h str lay /)
  (pid:set-layer lay)
  (entmakex (list '(0 . "MTEXT") (cons 8 lay) (cons 10 pt) (cons 40 h) (cons 41 w) (cons 1 str) '(7 . "Standard") '(71 . 1)))
)

(defun pid:block-start (name /)
  (if (tblsearch "BLOCK" name)
    nil
    (progn
      (entmakex (list '(0 . "BLOCK") (cons 2 name) '(70 . 0) (cons 10 (pid:pt 0 0))))
      T
    )
  )
)
(defun pid:block-end () (entmakex '((0 . "ENDBLK"))))

(defun pid:define-blocks (/)
  ;; Blocks are 2D reusable manual P&ID symbols. Tags/text are added separately.
  (if (pid:block-start "BLK_PID_VERTICAL_TANK")
    (progn (pid:rect -11 -18 11 18 "PID_EQUIPMENT") (pid:arc (pid:pt 0 18) 11 0.0 3.14159 "PID_EQUIPMENT") (pid:arc (pid:pt 0 -18) 11 3.14159 6.28318 "PID_EQUIPMENT") (pid:line (pid:pt -8 -18) (pid:pt -12 -24) "PID_EQUIPMENT") (pid:line (pid:pt 8 -18) (pid:pt 12 -24) "PID_EQUIPMENT") (pid:block-end)))
  (if (pid:block-start "BLK_PID_VACUUM_CRYSTALLIZER")
    (progn (pid:rect -15 -18 15 18 "PID_EQUIPMENT") (pid:arc (pid:pt 0 18) 15 0.0 3.14159 "PID_EQUIPMENT") (pid:arc (pid:pt 0 -18) 15 3.14159 6.28318 "PID_EQUIPMENT") (pid:line (pid:pt -15 3) (pid:pt 15 3) "PID_EQUIPMENT") (pid:line (pid:pt -15 -5) (pid:pt 15 -5) "PID_EQUIPMENT") (pid:line (pid:pt 0 28) (pid:pt 0 18) "PID_EQUIPMENT") (pid:line (pid:pt -8 -18) (pid:pt -12 -26) "PID_EQUIPMENT") (pid:line (pid:pt 8 -18) (pid:pt 12 -26) "PID_EQUIPMENT") (pid:block-end)))
  (if (pid:block-start "BLK_PID_CENTRIFUGE")
    (progn (pid:circle (pid:pt 0 0) 16 "PID_EQUIPMENT") (pid:circle (pid:pt 0 0) 8 "PID_EQUIPMENT") (pid:line (pid:pt -13 -10) (pid:pt 13 10) "PID_EQUIPMENT") (pid:line (pid:pt -13 10) (pid:pt 13 -10) "PID_EQUIPMENT") (pid:block-end)))
  (if (pid:block-start "BLK_PID_DRYER")
    (progn (pid:rect -22 -10 22 10 "PID_EQUIPMENT") (pid:line (pid:pt -18 -10) (pid:pt -10 10) "PID_EQUIPMENT") (pid:line (pid:pt -2 -10) (pid:pt 6 10) "PID_EQUIPMENT") (pid:line (pid:pt 12 -10) (pid:pt 20 10) "PID_EQUIPMENT") (pid:block-end)))
  (if (pid:block-start "BLK_PID_COOLER")
    (progn (pid:rect -18 -10 18 10 "PID_EQUIPMENT") (pid:line (pid:pt -18 0) (pid:pt 18 0) "PID_EQUIPMENT") (pid:line (pid:pt -10 -10) (pid:pt -10 10) "PID_EQUIPMENT") (pid:line (pid:pt 10 -10) (pid:pt 10 10) "PID_EQUIPMENT") (pid:block-end)))
  (if (pid:block-start "BLK_PID_MANUAL_VALVE")
    (progn (pid:pline (list (pid:pt -8 -5) (pid:pt 0 0) (pid:pt -8 5)) "PID_VALVE" T) (pid:pline (list (pid:pt 8 -5) (pid:pt 0 0) (pid:pt 8 5)) "PID_VALVE" T) (pid:block-end)))
  (if (pid:block-start "BLK_PID_CONTROL_VALVE")
    (progn (pid:pline (list (pid:pt -8 -5) (pid:pt 0 0) (pid:pt -8 5)) "PID_VALVE" T) (pid:pline (list (pid:pt 8 -5) (pid:pt 0 0) (pid:pt 8 5)) "PID_VALVE" T) (pid:line (pid:pt 0 0) (pid:pt 0 12) "PID_VALVE") (pid:circle (pid:pt 0 16) 4 "PID_VALVE") (pid:block-end)))
  (if (pid:block-start "BLK_PID_CHECK_VALVE")
    (progn (pid:pline (list (pid:pt -7 -6) (pid:pt 7 0) (pid:pt -7 6)) "PID_VALVE" T) (pid:line (pid:pt 8 -7) (pid:pt 8 7) "PID_VALVE") (pid:block-end)))
  (if (pid:block-start "BLK_PID_INSTRUMENT_BUBBLE") (progn (pid:circle (pid:pt 0 0) 7 "PID_INSTRUMENT") (pid:block-end)))
  (if (pid:block-start "BLK_PID_OFFPAGE_CONNECTOR")
    (progn (pid:pline (list (pid:pt -18 -7) (pid:pt 10 -7) (pid:pt 18 0) (pid:pt 10 7) (pid:pt -18 7)) "PID_BOUNDARY" T) (pid:block-end)))
  (if (pid:block-start "BLK_PID_FLOW_ARROW") (progn (pid:pline (list (pid:pt -5 -3) (pid:pt 5 0) (pid:pt -5 3)) "PID_PROCESS_LINE" T) (pid:block-end)))
  (if (pid:block-start "BLK_PID_SAMPLE_POINT") (progn (pid:circle (pid:pt 0 0) 3 "PID_SAFETY") (pid:line (pid:pt 0 0) (pid:pt 0 -9) "PID_SAFETY") (pid:block-end)))
  (if (pid:block-start "BLK_PID_DRAIN") (progn (pid:line (pid:pt 0 0) (pid:pt 0 -10) "PID_SAFETY") (pid:pline (list (pid:pt -5 -10) (pid:pt 5 -10) (pid:pt 0 -15)) "PID_SAFETY" T) (pid:block-end)))
  (if (pid:block-start "BLK_PID_VENT") (progn (pid:line (pid:pt 0 0) (pid:pt 0 10) "PID_SAFETY") (pid:arc (pid:pt 0 13) 3 0.0 3.14159 "PID_SAFETY") (pid:block-end)))
  (if (pid:block-start "BLK_PID_PSV") (progn (pid:circle (pid:pt 0 0) 6 "PID_SAFETY") (pid:pline (list (pid:pt -5 -2) (pid:pt 0 5) (pid:pt 5 -2)) "PID_SAFETY" T) (pid:block-end)))
  (if (pid:block-start "BLK_PID_VACUUM_BREAKER") (progn (pid:circle (pid:pt 0 0) 6 "PID_SAFETY") (pid:text (pid:pt -3 -2) 3 "VB" "PID_SAFETY") (pid:block-end)))
)

(defun pid:insert (name pt sx sy rot lay /)
  ;; Direct INSERT entity creation avoids command-stack/order issues.
  (pid:set-layer lay)
  (entmakex (list '(0 . "INSERT") (cons 8 lay) (cons 2 name) (cons 10 pt) (cons 41 sx) (cons 42 sy) (cons 43 1.0) (cons 50 rot)))
)
(defun pid:tag (x y tag name note /)
  (pid:text (pid:pt (- x 15) (- y 29)) 3.0 tag "PID_TEXT")
  (pid:text (pid:pt (- x 21) (- y 34)) 2.3 name "PID_TEXT")
  (pid:mtext (pid:pt (- x 25) (- y 40)) 54 1.8 note "PID_TEXT")
)
(defun pid:inst (x y tag /)
  (pid:insert "BLK_PID_INSTRUMENT_BUBBLE" (pid:pt x y) 1 1 0 "PID_INSTRUMENT")
  (pid:text (pid:pt (- x 6) (- y 1.5)) 2.5 tag "PID_INSTRUMENT")
)
(defun pid:valve (x y tag ctrl /)
  (pid:insert (if ctrl "BLK_PID_CONTROL_VALVE" "BLK_PID_MANUAL_VALVE") (pid:pt x y) 1 1 0 "PID_VALVE")
  (pid:text (pid:pt (- x 8) (+ y 8)) 2.2 tag "PID_VALVE")
)
(defun pid:opcon (x y txt rot /)
  (pid:insert "BLK_PID_OFFPAGE_CONNECTOR" (pid:pt x y) 1 1 rot "PID_BOUNDARY")
  (pid:mtext (pid:pt (- x 15) (+ y 2)) 45 2.0 txt "PID_TEXT")
)
(defun pid:arrow (x y rot /) (pid:insert "BLK_PID_FLOW_ARROW" (pid:pt x y) 1 1 rot "PID_PROCESS_LINE"))
(defun pid:label-line (x y lineNo service /) (pid:text (pid:pt x y) 2.2 (strcat lineNo "  " service) "PID_TEXT"))

(defun pid:process-line (pts lineNo service / p1 p2 midx midy)
  (setq p1 nil)
  (foreach p2 pts (if p1 (pid:line p1 p2 "PID_PROCESS_LINE")) (setq p1 p2))
  (setq p1 (car pts) p2 (last pts) p2 (car p2))
  (setq midx (/ (+ (car p1) (car p2)) 2.0) midy (/ (+ (cadr p1) (cadr p2)) 2.0))
  (pid:arrow midx midy 0)
  (pid:label-line (- midx 12) (+ midy 4) lineNo service)
)
(defun pid:utility-line (pts label / p1 p2 midx midy)
  (setq p1 nil)
  (foreach p2 pts (if p1 (pid:line p1 p2 "PID_UTILITY_LINE")) (setq p1 p2))
  (setq p1 (car pts) p2 (car (last pts)) midx (/ (+ (car p1) (car p2)) 2.0) midy (/ (+ (cadr p1) (cadr p2)) 2.0))
  (pid:text (pid:pt (- midx 10) (+ midy 3)) 2.0 label "PID_TEXT")
)
(defun pid:signal (pts / p1 p2)
  (setq p1 nil)
  (foreach p2 pts (if p1 (pid:line p1 p2 "PID_SIGNAL")) (setq p1 p2))
)
(defun pid:cv-station (x y tag /)
  (pid:valve (- x 16) y (strcat "HV-" tag "-U") nil)
  (pid:valve x y tag T)
  (pid:valve (+ x 16) y (strcat "HV-" tag "-D") nil)
  (pid:line (pid:pt (- x 24) (+ y 14)) (pid:pt (+ x 24) (+ y 14)) "PID_PROCESS_LINE")
  (pid:valve x (+ y 14) (strcat "HV-" tag "-BP") nil)
  (pid:line (pid:pt (- x 24) y) (pid:pt (- x 24) (+ y 14)) "PID_PROCESS_LINE")
  (pid:line (pid:pt (+ x 24) y) (pid:pt (+ x 24) (+ y 14)) "PID_PROCESS_LINE")
)

