(defun pid:draw-instruments (/)
  ;; Tank level instrumentation and signals.
  (foreach i '((75 458 "LI-302") (92 458 "LT-302") (110 458 "LIC-302") (72 438 "LSH-302") (72 405 "LSL-302")
               (150 323 "LI-303") (167 323 "LT-303") (185 323 "LIC-303") (147 303 "LSH-303") (147 270 "LSL-303")
               (405 183 "LI-304") (422 183 "LT-304") (440 183 "LIC-304") (402 163 "LSH-304") (402 130 "LSL-304"))
